{
    "default_route_id_enabled": true,
    "route_id_cleanup_regex": "^Route\\s*|_(\\w{2})(AM|am|PM|pm)$|PM_EM$|AM$",
    "route_id_not_unique_allowed": true,
    "route_id_not_unique_allowed_comment": "allow merge",
    "use_route_short_name_for_route_id": true,
    "route_short_name_cleaners_from_stop_name_comment": "Can't use route short name because wrong in data id:402_FMAM->sn:401AM (!)",
    "route_short_name_cleaners_from_stop_name": [
        {
            "regex": "^Rte ",
            "ignore_case": true,
            "comment": "Remove 'Rte ' prefix from route short name"
        },
        {
            "regex": "(AM|PM)$",
            "ignore_case": true,
            "comment": "Remove 'AM' or 'PM' suffix from route short name"
        }
    ],
    "route_short_name_cleaners": [
        {
            "regex": "^Route\\s*|_(\\w{2})(AM|am|PM|pm)$|PM_EM$|AM$",
            "comment": "clean route short from route ID (id:402_FMAM->sn:401AM (!))"
        }
    ],
    "route_short_name_to_route_id_configs": [
        {
            "route_short_name": "302_3",
            "route_id": 302003
        }
    ],
    "use_route_id_for_route_short_name": true,
    "use_route_id_for_route_short_name_comment": "Used because of wrong route short name in data id:402_FMAM->sn:401AM (!).",
    "default_route_long_name_enabled": true,
    "route_long_name_cleaners": [
        {
            "regex": "^Route \\d+ ",
            "comment": "Remove 'Route <number> ' prefix from route long name"
        },
        {
            "regex": "(_303PM)$",
            "comment": "Remove '_303PM' suffix from route long name"
        }
    ],
    "direction_finder_enabled": true,
    "direction_headsign_ignore_trip_headsign": true,
    "direction_headsign_ignore_trip_headsign_comment": "provided trip headsign are low quality",
    "trip_headsign_remove_via": true,
    "trip_headsign_cleaners": [
        {
            "comment": "add missing space around @",
            "regex": "\\s*@\\s*",
            "replacement": " @ "
        },
        {
            "comment": "Remove ends with Terminal-number from trip headsign",
            "regex": " Terminal-\\d+$",
            "ignore_case": true,
            "replacement": " Terminal"
        },
        {
            "comment": "Remove '<Main>' from trip headsign",
            "regex": "<Main>",
            "ignore_case": true,
            "replacement": ""
        },
        {
            "regex": "BeaconHill",
            "is_word": true,
            "replacement": "Beacon Hill"
        },
        {
            "regex": "EagleRidgeBLVD",
            "is_word": true,
            "replacement": "Eagle Ridge Blvd"
        },
        {
            "regex": "CallenDr",
            "is_word": true,
            "replacement": "Callen Dr"
        },
        {
            "regex": "HeritageDr",
            "is_word": true,
            "replacement": "Heritage Dr"
        },
        {
            "regex":"ParsonsCreek",
            "is_word": true,
            "replacement": "Parsons Creek"
        },
        {
            "regex": "RainbowCreek",
            "is_word": true,
            "replacement": "Rainbow Creek"
        },
        {
            "regex": "([a-z]+)(\\d+)",
            "ignore_case": true,
            "replacement": "$1 $2",
            "comment": "Add space between letters and numbers"
        },
        {
            "regex": "From(\\w+)",
            "ignore_case": false,
            "replacement": "From $1",
            "comment": "Add space after 'From'"
        },
        {
            "regex": "FaTher",
            "is_word": true,
            "replacement": "Father"
        },
        {
            "regex": "Sparrowehawk|SparrowHawk",
            "is_word": true,
            "replacement": "Sparrowhawk"
        }
    ],
    "stop_id_cleanup_regex": "^Sto|^0+",
    "stop_code_cleaners": [
        {
            "regex": "^0$"
        }
    ],
    "stop_name_cleaners": []
}